<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and below.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!--
       The commitment passphrase is sealed with a key that lives in this device's keystore, and
       keystore keys are never part of a backup. Restoring the file on its own leaves a keyset
       that nothing can decrypt.
    -->
    <exclude domain="sharedpref" path="commitment_password_prefs.xml" />
    <!--
       Whether the accessibility service was running, and the watchdog's outage count, describe
       this device. Restored onto another one they report a force stop that never happened there.
    -->
    <exclude domain="sharedpref" path="service_reliability_prefs.xml" />
</full-backup-content>
