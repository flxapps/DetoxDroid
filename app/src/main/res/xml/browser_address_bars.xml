    <browser package="com.opera.gx"><addressBar id="id/addressbarEdit" /></browser>
    <browser package="com.opera.mini.native"><addressBar id="id/url_field" /></browser>
    <browser package="com.opera.mini.native.beta"><addressBar id="id/url_field" /></browser>
    <browser package="com.duckduckgo.mobile.android">
