    <!-- region Shizuku Setup Wizard -->
    <string name="shizukuSetup_title">Set up grayscale</string>
    <string name="shizukuSetup_intro">Grayscale needs a one-time special permission. Without a computer, the easiest way is Shizuku — a free, trusted helper app. This takes about five minutes, and the permission survives reboots.</string>
    <string name="shizukuSetup_rooted">Your device appears to be rooted — you can skip Shizuku and grant the permission directly.</string>
    <string name="shizukuSetup_rooted_go">Grant via root</string>
    <string name="shizukuSetup_step1_title">Install Shizuku</string>
    <string name="shizukuSetup_step1_description">Get the free Shizuku app from Google Play.</string>
    <string name="shizukuSetup_step1_go">Open Play Store</string>
    <string name="shizukuSetup_step2_title">Start the Shizuku service</string>
    <string name="shizukuSetup_step2_description">Open Shizuku and follow "Start via Wireless debugging". If Developer options are not enabled yet: in the phone settings, find "Build number" (usually under About phone) and tap it seven times, then enable "Wireless debugging" in the Developer options. Shizuku guides you through the pairing.</string>
    <string name="shizukuSetup_step2_openShizuku">Open Shizuku</string>
    <string name="shizukuSetup_step2_openDeveloperSettings">Developer settings</string>
    <string name="shizukuSetup_step2_rebootHint">Note: after every reboot, Shizuku has to be started again — the permission it grants stays, though.</string>
    <string name="shizukuSetup_step3_title">Allow DetoxDroid to use Shizuku</string>
    <string name="shizukuSetup_step3_description">Shizuku will ask for your confirmation in a dialog.</string>
    <string name="shizukuSetup_step3_go">Request access</string>
    <string name="shizukuSetup_step4_title">Grant the grayscale permission</string>
    <string name="shizukuSetup_step4_description">One tap — DetoxDroid grants itself the color-filter permission through Shizuku.</string>
    <string name="shizukuSetup_step4_go">Grant permission</string>
    <string name="shizukuSetup_completed_title">All done!</string>
    <string name="shizukuSetup_completed_message">The permission is granted and grayscale is ready. If it was waiting from your setup, it is now active.</string>
    <string name="shizukuSetup_completed_done">Done</string>
