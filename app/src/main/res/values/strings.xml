    <string name="onboarding_action_skipSetup">Skip setup</string>
    <string name="onboarding_skipSetup_dialog_title">Skip the setup?</string>
    <string name="onboarding_skipSetup_dialog_message">Nothing will be configured. You can set up every feature later on its own screen, or replay this setup from the About screen.</string>
