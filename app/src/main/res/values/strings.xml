    <string name="onboarding_welcome_title">Take back your attention</string>
    <string name="onboarding_welcome_message">DetoxDroid helps you break autopilot habits: it can gray out distracting apps, interrupt endless scrolling and block apps once your daily budget is used up. In the next steps, we\'ll tailor it to how you actually use your phone.</string>
    <string name="onboarding_welcome_privacy">Everything stays on your device. DetoxDroid is open source, has no ads and collects nothing.</string>
    <string name="onboarding_usageAccess_title">See where your time goes</string>
    <string name="onboarding_usageAccess_message">To suggest which apps to tame — and realistic daily goals — DetoxDroid needs the system\'s "usage access". It also powers your usage statistics. The data never leaves your phone.</string>
    <string name="onboarding_usageAccess_grant">Grant usage access</string>
    <string name="onboarding_usageAccess_granted">Usage access granted — we can now make personal suggestions.</string>
    <string name="onboarding_usageAccess_skipHint">You can skip this — we\'ll suggest apps by category instead.</string>
    <string name="onboarding_apps_title">Your distracting apps</string>
    <string name="onboarding_apps_message">Based on your usage and app categories, these are likely your biggest time sinks. Adjust the selection — the next steps act on the selected apps.</string>
    <string name="onboarding_apps_loading">Analyzing your app usage…</string>
    <string name="onboarding_apps_empty">No suitable apps were found on this device. You can still pick apps for every feature later on.</string>
    <string name="onboarding_apps_avgUsage">%s / day</string>
    <plurals name="onboarding_apps_selectedCount">
        <item quantity="one">%d app selected</item>
        <item quantity="other">%d apps selected</item>
    </plurals>
    <string name="onboarding_preset_title">How strict should it be?</string>
    <string name="onboarding_preset_message">Pick a starting point — every detail can be changed later.</string>
    <string name="onboarding_preset_gentle">Gentle</string>
    <string name="onboarding_preset_gentle_description">Interrupts endless scrolling in the selected apps with a break screen.</string>
    <string name="onboarding_preset_balanced">Balanced</string>
    <string name="onboarding_preset_balanced_badge">Recommended</string>
    <string name="onboarding_preset_balanced_description">Gentle, plus: the selected apps turn grayscale once your daily budget is used up — without color, they lose much of their pull.</string>
    <string name="onboarding_preset_strict">Strict</string>
    <string name="onboarding_preset_strict_description">Balanced, plus: the selected apps are blocked entirely once the daily budget is spent — grayscale already warns you shortly before.</string>
    <string name="onboarding_preset_budget">Daily budget</string>
    <string name="onboarding_preset_budget_description">Your daily allowance for the selected apps before DetoxDroid steps in.</string>
    <string name="onboarding_preset_budget_suggested">Suggested from your last 7 days of usage</string>
    <string name="onboarding_preset_preview">See it in action</string>
    <string name="onboarding_preset_preview_description">Preview grayscale on your screen for a few seconds.</string>
    <string name="onboarding_permissions_title">A few permissions</string>
    <string name="onboarding_permissions_message">Your setup needs the permissions below. Grant what you like — anything missing can be granted later from the feature screens.</string>
    <string name="onboarding_permissions_overlay">Display over other apps</string>
    <string name="onboarding_permissions_overlay_description">Needed to show break screens and to block apps.</string>
    <string name="onboarding_permissions_notifications">Notifications</string>
    <string name="onboarding_permissions_notifications_description">Status and reminders while a detox feature is active.</string>
    <string name="onboarding_permissions_secureSettings">Grayscale permission</string>
    <string name="onboarding_permissions_secureSettings_description">A special permission that lets DetoxDroid control the system\'s color filters.</string>
    <string name="onboarding_permissions_secureSettings_oneTap">Tap to grant — Shizuku or root was detected on your device.</string>
    <string name="onboarding_permissions_secureSettings_later">Tap for a guided setup — or finish this later; we\'ll remind you on the home screen.</string>
    <string name="onboarding_permissions_accessibility">Accessibility service</string>
    <string name="onboarding_permissions_accessibility_description">DetoxDroid\'s engine: the accessibility service detects which app is in the foreground and applies your rules. No data leaves your device.</string>
    <string name="onboarding_permissions_accessibility_auto">Tap to enable it automatically.</string>
    <string name="onboarding_permissions_accessibility_manual">Tap to open the accessibility settings and enable DetoxDroid there.</string>
    <string name="onboarding_permissions_state_granted">Granted</string>
