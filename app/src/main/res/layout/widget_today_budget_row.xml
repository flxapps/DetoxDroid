<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_budget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp">

    <ImageView
        android:id="@+id/widget_today_budget_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:padding="1dp"
        android:tint="?attr/widgetAccent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_today_budget_name"
                style="@style/WidgetToday.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/widgetOnSurface"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/widget_today_budget_left"
                style="@style/WidgetToday.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/widgetAccent" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/widget_today_budget_bar"
            style="@style/WidgetToday.Bar"
            android:layout_width="match_parent"
            android:layout_marginTop="3dp" />
    </LinearLayout>
</LinearLayout>
