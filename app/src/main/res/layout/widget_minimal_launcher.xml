<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_minimal_launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- the lines share the height; code can leave some of it over, which then goes above and
         below them -->
    <LinearLayout
        android:id="@+id/widget_minimal_launcher_items_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/widget_minimal_launcher_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_minimalLauncher_empty"
        android:textColor="?attr/widgetOnSurface"
        android:textSize="20sp" />

</FrameLayout>
